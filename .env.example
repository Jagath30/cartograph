# Postgres superuser — owns the application database
POSTGRES_USER=cartograph
POSTGRES_PASSWORD=replace-me

# One instance, two databases (DD-03)
APP_DB_NAME=cartograph_app
WAREHOUSE_DB_NAME=cartograph_warehouse

# SELECT-only role used for every warehouse query (NFR-07)
WAREHOUSE_RO_USER=cartograph_ro
WAREHOUSE_RO_PASSWORD=replace-me

# OpenAI key for embeddings (step 6) and SQL generation (step 7). Optional:
# the stack starts without it, and anything that needs it says so. The real
# value goes in .env, which git ignores, and nowhere else (NFR-09).
OPENAI_API_KEY=

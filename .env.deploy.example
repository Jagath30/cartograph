# The deployment's secrets (step 12). The real file is .env.deploy, beside
# this one, ignored by git, mode 600. It is edited only with nano in the
# owner's own terminal, and it reaches commands only through
# `docker run --env-file .env.deploy`, which print nothing of it.

# Pasted by the owner: Neon's own role, the direct (not pooled) connection
# string, database neondb. Never leaves the laptop.
NEON_OWNER_URL=

# Written by scripts/neon.sh roles, inside a container, never printed:
# 40 letters and digits each, and the two direct URLs Render is given.
APP_ROLE_PASSWORD=
READER_PASSWORD=
APP_DATABASE_URL=
WAREHOUSE_DATABASE_URL=
